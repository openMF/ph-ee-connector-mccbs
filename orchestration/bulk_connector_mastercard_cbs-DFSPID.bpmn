<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.0.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.0.0">
  <bpmn:process id="bulk_connector_mastercard_cbs-DFSPID" name="Mastercard CBS Payment Connector" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1" name="Start CBS Payment">
      <bpmn:outgoing>Flow_start_to_validate</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Validate Input -->
    <bpmn:serviceTask id="Task_ValidateInput" name="Validate Input">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="mastercard-cbs-validate-input" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_start_to_validate</bpmn:incoming>
      <bpmn:outgoing>Flow_validate_to_auth</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Authenticate with Mastercard -->
    <bpmn:serviceTask id="Task_Authenticate" name="Authenticate with Mastercard CBS">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="mastercard-cbs-authenticate" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_validate_to_auth</bpmn:incoming>
      <bpmn:incoming>Flow_auth_retry</bpmn:incoming>
      <bpmn:outgoing>Flow_auth_to_gateway</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Check Authentication Success -->
    <bpmn:exclusiveGateway id="Gateway_AuthSuccess" name="Auth Success?">
      <bpmn:incoming>Flow_auth_to_gateway</bpmn:incoming>
      <bpmn:outgoing>Flow_auth_success</bpmn:outgoing>
      <bpmn:outgoing>Flow_auth_failed</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Match Regulatory Data -->
    <bpmn:serviceTask id="Task_MatchRegulatoryData" name="Match Regulatory Data">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="mastercard-cbs-match-regulatory-data" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_auth_success</bpmn:incoming>
      <bpmn:outgoing>Flow_match_to_gateway</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Check Data Found -->
    <bpmn:exclusiveGateway id="Gateway_DataFound" name="Data Found?">
      <bpmn:incoming>Flow_match_to_gateway</bpmn:incoming>
      <bpmn:outgoing>Flow_data_found</bpmn:outgoing>
      <bpmn:outgoing>Flow_data_not_found</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Initiate CBS Payment -->
    <bpmn:serviceTask id="Task_InitiatePayment" name="Initiate CBS Payment">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="mastercard-cbs-initiate-payment" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_data_found</bpmn:incoming>
      <bpmn:incoming>Flow_payment_retry</bpmn:incoming>
      <bpmn:outgoing>Flow_payment_to_gateway</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Check Payment Submission Success -->
    <bpmn:exclusiveGateway id="Gateway_PaymentSuccess" name="Payment Submitted?">
      <bpmn:incoming>Flow_payment_to_gateway</bpmn:incoming>
      <bpmn:outgoing>Flow_payment_success</bpmn:outgoing>
      <bpmn:outgoing>Flow_payment_failed</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Wait for Payment Processing (Timer) -->
    <bpmn:intermediateCatchEvent id="Event_WaitForProcessing" name="Wait 3s">
      <bpmn:incoming>Flow_payment_success</bpmn:incoming>
      <bpmn:outgoing>Flow_wait_to_status</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_1">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT3S</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>

    <!-- Check Payment Status -->
    <bpmn:serviceTask id="Task_CheckStatus" name="Retrieve Payment Status">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="mastercard-cbs-check-status" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_wait_to_status</bpmn:incoming>
      <bpmn:outgoing>Flow_status_to_gateway</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Check Status Result -->
    <bpmn:exclusiveGateway id="Gateway_StatusCheck" name="Status Retrieved?">
      <bpmn:incoming>Flow_status_to_gateway</bpmn:incoming>
      <bpmn:outgoing>Flow_status_success</bpmn:outgoing>
      <bpmn:outgoing>Flow_status_failed</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Update Operations DB -->
    <bpmn:serviceTask id="Task_UpdateOperations" name="Update Operations DB">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="mastercard-cbs-update-operations" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_status_success</bpmn:incoming>
      <bpmn:incoming>Flow_status_failed</bpmn:incoming>
      <bpmn:outgoing>Flow_update_to_end</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Successful End -->
    <bpmn:endEvent id="EndEvent_Success" name="Payment Complete">
      <bpmn:incoming>Flow_update_to_end</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Error Handling Tasks -->

    <!-- Auth Retry Logic -->
    <bpmn:serviceTask id="Task_AuthRetry" name="Retry Authentication">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="mastercard-cbs-retry-handler" />
        <zeebe:taskHeaders>
          <zeebe:header key="retryType" value="auth" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_auth_failed</bpmn:incoming>
      <bpmn:outgoing>Flow_auth_retry_check</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:exclusiveGateway id="Gateway_AuthRetry" name="Retry Auth?">
      <bpmn:incoming>Flow_auth_retry_check</bpmn:incoming>
      <bpmn:outgoing>Flow_auth_retry</bpmn:outgoing>
      <bpmn:outgoing>Flow_auth_max_retries</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Payment Retry Logic -->
    <bpmn:serviceTask id="Task_PaymentRetry" name="Retry Payment">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="mastercard-cbs-retry-handler" />
        <zeebe:taskHeaders>
          <zeebe:header key="retryType" value="payment" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_payment_failed</bpmn:incoming>
      <bpmn:outgoing>Flow_payment_retry_check</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:exclusiveGateway id="Gateway_PaymentRetry" name="Retry Payment?">
      <bpmn:incoming>Flow_payment_retry_check</bpmn:incoming>
      <bpmn:outgoing>Flow_payment_retry</bpmn:outgoing>
      <bpmn:outgoing>Flow_payment_max_retries</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Error Logging -->
    <bpmn:serviceTask id="Task_LogAuthError" name="Log Auth Error">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="mastercard-cbs-log-error" />
        <zeebe:taskHeaders>
          <zeebe:header key="errorType" value="AUTH_FAILED" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_auth_max_retries</bpmn:incoming>
      <bpmn:outgoing>Flow_auth_error_to_end</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_LogDataError" name="Log Data Not Found">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="mastercard-cbs-log-error" />
        <zeebe:taskHeaders>
          <zeebe:header key="errorType" value="DATA_NOT_FOUND" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_data_not_found</bpmn:incoming>
      <bpmn:outgoing>Flow_data_error_to_end</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_LogPaymentError" name="Log Payment Error">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="mastercard-cbs-log-error" />
        <zeebe:taskHeaders>
          <zeebe:header key="errorType" value="PAYMENT_FAILED" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_payment_max_retries</bpmn:incoming>
      <bpmn:outgoing>Flow_payment_error_to_end</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Error End Events -->
    <bpmn:endEvent id="EndEvent_AuthError" name="Auth Failed">
      <bpmn:incoming>Flow_auth_error_to_end</bpmn:incoming>
      <bpmn:errorEventDefinition id="ErrorEventDefinition_Auth" errorRef="Error_AuthFailed" />
    </bpmn:endEvent>

    <bpmn:endEvent id="EndEvent_DataError" name="Data Not Found">
      <bpmn:incoming>Flow_data_error_to_end</bpmn:incoming>
      <bpmn:errorEventDefinition id="ErrorEventDefinition_Data" errorRef="Error_DataNotFound" />
    </bpmn:endEvent>

    <bpmn:endEvent id="EndEvent_PaymentError" name="Payment Failed">
      <bpmn:incoming>Flow_payment_error_to_end</bpmn:incoming>
      <bpmn:errorEventDefinition id="ErrorEventDefinition_Payment" errorRef="Error_PaymentFailed" />
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="Flow_start_to_validate" sourceRef="StartEvent_1" targetRef="Task_ValidateInput" />
    <bpmn:sequenceFlow id="Flow_validate_to_auth" sourceRef="Task_ValidateInput" targetRef="Task_Authenticate" />
    <bpmn:sequenceFlow id="Flow_auth_to_gateway" sourceRef="Task_Authenticate" targetRef="Gateway_AuthSuccess" />
    <bpmn:sequenceFlow id="Flow_auth_success" name="Yes" sourceRef="Gateway_AuthSuccess" targetRef="Task_MatchRegulatoryData">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=authSuccess = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_auth_failed" name="No" sourceRef="Gateway_AuthSuccess" targetRef="Task_AuthRetry">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=authSuccess = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Flow_match_to_gateway" sourceRef="Task_MatchRegulatoryData" targetRef="Gateway_DataFound" />
    <bpmn:sequenceFlow id="Flow_data_found" name="Yes" sourceRef="Gateway_DataFound" targetRef="Task_InitiatePayment">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=supplementaryDataFound = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_data_not_found" name="No" sourceRef="Gateway_DataFound" targetRef="Task_LogDataError">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=supplementaryDataFound = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Flow_payment_to_gateway" sourceRef="Task_InitiatePayment" targetRef="Gateway_PaymentSuccess" />
    <bpmn:sequenceFlow id="Flow_payment_success" name="Yes" sourceRef="Gateway_PaymentSuccess" targetRef="Event_WaitForProcessing">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=paymentSubmitted = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_payment_failed" name="No" sourceRef="Gateway_PaymentSuccess" targetRef="Task_PaymentRetry">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=paymentSubmitted = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Flow_wait_to_status" sourceRef="Event_WaitForProcessing" targetRef="Task_CheckStatus" />
    <bpmn:sequenceFlow id="Flow_status_to_gateway" sourceRef="Task_CheckStatus" targetRef="Gateway_StatusCheck" />
    <bpmn:sequenceFlow id="Flow_status_success" name="Yes" sourceRef="Gateway_StatusCheck" targetRef="Task_UpdateOperations">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=statusRetrieved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_status_failed" name="No (Continue)" sourceRef="Gateway_StatusCheck" targetRef="Task_UpdateOperations">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=statusRetrieved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Flow_update_to_end" sourceRef="Task_UpdateOperations" targetRef="EndEvent_Success" />

    <!-- Retry Flows -->
    <bpmn:sequenceFlow id="Flow_auth_retry_check" sourceRef="Task_AuthRetry" targetRef="Gateway_AuthRetry" />
    <bpmn:sequenceFlow id="Flow_auth_retry" name="Yes" sourceRef="Gateway_AuthRetry" targetRef="Task_Authenticate">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=authRetryCount &lt; 3</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_auth_max_retries" name="No" sourceRef="Gateway_AuthRetry" targetRef="Task_LogAuthError">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=authRetryCount &gt;= 3</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Flow_payment_retry_check" sourceRef="Task_PaymentRetry" targetRef="Gateway_PaymentRetry" />
    <bpmn:sequenceFlow id="Flow_payment_retry" name="Yes" sourceRef="Gateway_PaymentRetry" targetRef="Task_InitiatePayment">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=paymentRetryCount &lt; 3</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_payment_max_retries" name="No" sourceRef="Gateway_PaymentRetry" targetRef="Task_LogPaymentError">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=paymentRetryCount &gt;= 3</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Error End Flows -->
    <bpmn:sequenceFlow id="Flow_auth_error_to_end" sourceRef="Task_LogAuthError" targetRef="EndEvent_AuthError" />
    <bpmn:sequenceFlow id="Flow_data_error_to_end" sourceRef="Task_LogDataError" targetRef="EndEvent_DataError" />
    <bpmn:sequenceFlow id="Flow_payment_error_to_end" sourceRef="Task_LogPaymentError" targetRef="EndEvent_PaymentError" />
  </bpmn:process>

  <!-- Error Definitions -->
  <bpmn:error id="Error_AuthFailed" name="AUTH_FAILED" errorCode="CBS_AUTH_FAILED" />
  <bpmn:error id="Error_DataNotFound" name="DATA_NOT_FOUND" errorCode="CBS_DATA_NOT_FOUND" />
  <bpmn:error id="Error_PaymentFailed" name="PAYMENT_FAILED" errorCode="CBS_PAYMENT_FAILED" />

  <!-- BPMN Diagram -->
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="bulk_connector_mastercard_cbs-DFSPID">
      <!-- Start Event -->
      <bpmndi:BPMNShape id="StartEvent_1_di" bpmnElement="StartEvent_1">
        <dc:Bounds x="152" y="212" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="129" y="255" width="82" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- Validate Input -->
      <bpmndi:BPMNShape id="Task_ValidateInput_di" bpmnElement="Task_ValidateInput">
        <dc:Bounds x="240" y="190" width="100" height="80" />
      </bpmndi:BPMNShape>

      <!-- Authenticate -->
      <bpmndi:BPMNShape id="Task_Authenticate_di" bpmnElement="Task_Authenticate">
        <dc:Bounds x="390" y="190" width="100" height="80" />
      </bpmndi:BPMNShape>

      <!-- Auth Gateway -->
      <bpmndi:BPMNShape id="Gateway_AuthSuccess_di" bpmnElement="Gateway_AuthSuccess" isMarkerVisible="true">
        <dc:Bounds x="545" y="205" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="533" y="181" width="74" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- Match Data -->
      <bpmndi:BPMNShape id="Task_MatchRegulatoryData_di" bpmnElement="Task_MatchRegulatoryData">
        <dc:Bounds x="650" y="190" width="100" height="80" />
      </bpmndi:BPMNShape>

      <!-- Data Gateway -->
      <bpmndi:BPMNShape id="Gateway_DataFound_di" bpmnElement="Gateway_DataFound" isMarkerVisible="true">
        <dc:Bounds x="805" y="205" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="795" y="181" width="70" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- Initiate Payment -->
      <bpmndi:BPMNShape id="Task_InitiatePayment_di" bpmnElement="Task_InitiatePayment">
        <dc:Bounds x="910" y="190" width="100" height="80" />
      </bpmndi:BPMNShape>

      <!-- Payment Gateway -->
      <bpmndi:BPMNShape id="Gateway_PaymentSuccess_di" bpmnElement="Gateway_PaymentSuccess" isMarkerVisible="true">
        <dc:Bounds x="1065" y="205" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1058" y="175" width="65" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- Wait Timer -->
      <bpmndi:BPMNShape id="Event_WaitForProcessing_di" bpmnElement="Event_WaitForProcessing">
        <dc:Bounds x="1172" y="212" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1172" y="255" width="37" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- Check Status -->
      <bpmndi:BPMNShape id="Task_CheckStatus_di" bpmnElement="Task_CheckStatus">
        <dc:Bounds x="1260" y="190" width="100" height="80" />
      </bpmndi:BPMNShape>

      <!-- Status Gateway -->
      <bpmndi:BPMNShape id="Gateway_StatusCheck_di" bpmnElement="Gateway_StatusCheck" isMarkerVisible="true">
        <dc:Bounds x="1415" y="205" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1397" y="175" width="86" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- Update Operations -->
      <bpmndi:BPMNShape id="Task_UpdateOperations_di" bpmnElement="Task_UpdateOperations">
        <dc:Bounds x="1520" y="190" width="100" height="80" />
      </bpmndi:BPMNShape>

      <!-- Success End -->
      <bpmndi:BPMNShape id="EndEvent_Success_di" bpmnElement="EndEvent_Success">
        <dc:Bounds x="1672" y="212" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1647" y="255" width="87" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- Error Handling Shapes -->
      <bpmndi:BPMNShape id="Task_AuthRetry_di" bpmnElement="Task_AuthRetry">
        <dc:Bounds x="520" y="320" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Gateway_AuthRetry_di" bpmnElement="Gateway_AuthRetry" isMarkerVisible="true">
        <dc:Bounds x="415" y="335" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="410" y="311" width="60" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_PaymentRetry_di" bpmnElement="Task_PaymentRetry">
        <dc:Bounds x="1040" y="320" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Gateway_PaymentRetry_di" bpmnElement="Gateway_PaymentRetry" isMarkerVisible="true">
        <dc:Bounds x="935" y="335" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="920" y="311" width="80" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_LogAuthError_di" bpmnElement="Task_LogAuthError">
        <dc:Bounds x="390" y="450" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_LogDataError_di" bpmnElement="Task_LogDataError">
        <dc:Bounds x="780" y="320" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_LogPaymentError_di" bpmnElement="Task_LogPaymentError">
        <dc:Bounds x="910" y="450" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="EndEvent_AuthError_di" bpmnElement="EndEvent_AuthError">
        <dc:Bounds x="422" y="582" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="413" y="625" width="55" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="EndEvent_DataError_di" bpmnElement="EndEvent_DataError">
        <dc:Bounds x="812" y="452" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="790" y="495" width="81" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="EndEvent_PaymentError_di" bpmnElement="EndEvent_PaymentError">
        <dc:Bounds x="942" y="582" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="921" y="625" width="78" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- Sequence Flow Edges -->
      <bpmndi:BPMNEdge id="Flow_start_to_validate_di" bpmnElement="Flow_start_to_validate">
        <di:waypoint x="188" y="230" />
        <di:waypoint x="240" y="230" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_validate_to_auth_di" bpmnElement="Flow_validate_to_auth">
        <di:waypoint x="340" y="230" />
        <di:waypoint x="390" y="230" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_auth_to_gateway_di" bpmnElement="Flow_auth_to_gateway">
        <di:waypoint x="490" y="230" />
        <di:waypoint x="545" y="230" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_auth_success_di" bpmnElement="Flow_auth_success">
        <di:waypoint x="595" y="230" />
        <di:waypoint x="650" y="230" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="604" y="212" width="18" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_auth_failed_di" bpmnElement="Flow_auth_failed">
        <di:waypoint x="570" y="255" />
        <di:waypoint x="570" y="320" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="578" y="285" width="15" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

